# Safe local demo: deterministic lexical vectors + extractive answers, no API calls.
ATLAS_DATABASE_URL=sqlite:///./data/atlas.db
ATLAS_DATA_DIR=./data
ATLAS_EMBEDDING_PROVIDER=hash
ATLAS_LLM_PROVIDER=extractive
ATLAS_CHUNK_STRATEGY=sentence
# Optional Docker host port if a local development server already uses 8000.
# ATLAS_PORT=8002
# Genuine local semantic retrieval: install .[local], select fastembed, then reindex.
# ATLAS_EMBEDDING_PROVIDER=fastembed
# ATLAS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ATLAS_CHUNK_STRATEGY=semantic
# ATLAS_MODEL_CACHE_DIR=./data/models
# Tune the provider-specific vector similarity cutoff using your evaluation dataset.
# ATLAS_MIN_VECTOR_SIMILARITY=0.6
# OpenAI: both providers can be selected independently. No paid calls in default mode.
# ATLAS_EMBEDDING_PROVIDER=openai
# ATLAS_EMBEDDING_MODEL=text-embedding-3-small
# ATLAS_LLM_PROVIDER=openai
# ATLAS_LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# Genuine local LLM answers via Ollama (no paid API key).
# Start Ollama and download a model before selecting this provider.
# ATLAS_LLM_PROVIDER=ollama
# ATLAS_LLM_MODEL=qwen3:1.7b
# ATLAS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker uses http://host.docker.internal:11434 by default.
# ATLAS_OLLAMA_CONTEXT_TOKENS=8192
# ATLAS_OLLAMA_MAX_OUTPUT_TOKENS=512
# Optional shared API key (all /api routes except /api/health require this header).
# ATLAS_API_KEY=replace-with-a-long-random-secret
# ATLAS_CHROMA_HOST=chroma
# ATLAS_CHROMA_PORT=8000
